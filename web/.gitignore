# Logs. Anchored: a bare `logs` matches any directory of that name at any
# depth, which silently kept src/components/logs/LogView.tsx - the Live Log
# view - out of the repo entirely. Only web/logs/ is meant here.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
