*venv*
__pycache__
config.json
debug
cache
# Test runs write their logs here. (This used to be *test*, which also hid
# tests/ itself and utils/xtest.py.)
tests/logs/

# Personal presets and backups; config.template.json is the schema of record.
config.*.json
!config.template.json
# The config page saves every preset here, whichever device it is opened from.
uma_configs/
# The owned-support-card scan: account data regenerated locally, not repo data.
data/support_cards_owned.json

# Design canvas working files
design/

# Logs. Anchored to the repo root on purpose: a bare `logs` matches a
# directory of that name at any depth, and it was quietly keeping
# web/src/components/logs/ - the Live Log view's source - out of the repo.
# tests/logs/ has its own rule above.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist_ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
config.json
shots/
